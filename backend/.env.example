# Copie para backend/.env e preencha. O .env NÃO é versionado.

# Conexão como o role app_api (login, noinherit, sem bypassrls).
#
# `?sslmode=require` NÃO é opcional fora do localhost: sem ele o asyncpg usa o default
# `prefer`, que tenta TLS mas aceita texto puro em silêncio e não valida o certificado.
# Entre o Render e o Supabase isso é dado clínico e a senha do app_api atravessando a
# internet pública sem garantia.
#
# Produção: transaction pooler, porta 6543, usuário no formato <role>.<project_ref>.
#   postgresql://app_api.<project_ref>:<senha>@aws-1-<região>.pooler.supabase.com:6543/postgres?sslmode=require
# Local (loopback, sem TLS):
#   postgresql://app_api:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Projeto Supabase. O issuer esperado no JWT é <SUPABASE_URL>/auth/v1.
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_JWKS_URL=https://<project_ref>.supabase.co/auth/v1/.well-known/jwks.json

# Origens liberadas no CORS, separadas por vírgula. '*' é recusado no boot.
CORS_ORIGINS=http://localhost:4200,https://www.infrajoint.com.br

# /docs e /openapi.json. Deixe false em produção.
DOCS_ENABLED=true

# --- Cloudflare R2: usados a partir da Fase 5 ---
#
# Sem eles a API sobe normalmente e só o upload de capturas responde 503 — pacientes,
# consultas e body map não dependem do bucket.
#
# Para testar upload em DESENVOLVIMENTO (ENV_FILE=.env.local), não coloque estes
# valores no .env.local: ele é versionado. Crie `backend/.env.secrets`, que o git
# ignora e é lido depois do arquivo de modo:
#
#     R2_ENDPOINT=...
#     R2_BUCKET=...
#     R2_ACCESS_KEY_ID=...
#     R2_SECRET_ACCESS_KEY=...
#
# O bucket precisa de política de CORS liberando a origem do frontend (inclusive
# http://localhost:4200), senão o PUT do navegador é bloqueado antes de sair.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
