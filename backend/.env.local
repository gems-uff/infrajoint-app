# Modo LOCAL (opção A) — tudo no Docker. Use com: ENV_FILE=.env.local
#
# Este arquivo É versionado, ao contrário do .env. Todos os valores aqui são as
# credenciais fixas do Supabase CLI: idênticas em qualquer instalação, publicadas na
# documentação e alcançáveis só em 127.0.0.1.
#
# NUNCA coloque segredo real aqui. Segredo vai no .env, que o git ignora.

DATABASE_URL=postgresql://app_api:postgres@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

CORS_ORIGINS=http://localhost:4200
